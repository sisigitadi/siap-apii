NODE_ENV=development
PORT=3000

# Frontend SPA (redirect setelah login/callback & logout)
FRONTEND_URL=http://localhost:5173

# Database (docker compose lokal / Neon di produksi)
DATABASE_URL=postgresql://apii:apii@localhost:5432/apii_jabo

# Cache & pub/sub (docker compose lokal / Upstash di produksi)
REDIS_URL=redis://localhost:6379

# Storage S3 (MinIO lokal / Cloudflare R2 di produksi)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=apii-jabo

# Google OAuth 2.0 (PKCE)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# JWT RS256 — path file (dev) ATAU string satu baris (produksi, lihat DESIGN.md §11.4)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# URL publik untuk QR verifikasi (frontend SPA)
PUBLIC_VERIFY_BASE_URL=https://app.apii.sigitadi.id/verify

# CORS — asal frontend yang diizinkan akses API (dengan kredensial/cookie)
CORS_ORIGINS=http://localhost:5173,https://app.apii.sigitadi.id
