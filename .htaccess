# ==============================================================================
# SIAP APII Root - Routing & Security Configuration
# Domain 1: siapii.sigitadi.id -> Portal Pengurus (/portal)
# Domain 2: apii.sigitadi.id   -> Portal Publik (/public)
# ==============================================================================
Options -MultiViews
RewriteEngine On

# 1. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 2. Prevent Directory Browsing
Options -Indexes

# 3. Domain SIAPII (siapii.sigitadi.id) -> Portal Pengurus
RewriteCond %{HTTP_HOST} ^(www\.)?siapii\. [NC]
RewriteCond %{REQUEST_URI} !^/portal/
RewriteCond %{DOCUMENT_ROOT}/portal/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/portal/$1 -d
RewriteRule ^(.*)$ portal/$1 [L]

RewriteCond %{HTTP_HOST} ^(www\.)?siapii\. [NC]
RewriteCond %{REQUEST_URI} !^/portal/
RewriteRule ^(.*)$ portal/index.html [L]

# 4. Domain APII (apii.sigitadi.id) atau Host Lain -> Portal Publik
RewriteCond %{HTTP_HOST} !^(www\.)?siapii\. [NC]
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.*)$ public/$1 [L]

RewriteCond %{HTTP_HOST} !^(www\.)?siapii\. [NC]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/index.html [L]
