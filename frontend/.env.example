# Konfigurasi lingkungan untuk Vercel project FRONTEND (app.apii.sigitadi.id).
# Salin ke env project Vercel (Settings → Environment Variables) untuk produksi.

# WAJIB di produksi: base URL backend API. Tanpa ini, frontend jatuh ke
# same-origin "/api/v1" yang salah untuk domain app.apii.sigitadi.id.
VITE_API_URL=https://apii.sigitadi.id/api/v1
