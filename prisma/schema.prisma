// Sumber kebenaran skema database (lihat DESIGN.md §4).
// Konvensi: tabel & kolom snake_case via @@map/@map; enum mengikuti DESIGN.md §5.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 13 peran bertingkat (DESIGN.md §5.1)
enum UserRole {
  SUPERADMIN
  KETUA_UMUM
  SEKRETARIS
  BENDAHARA
  DEWAN_PENGAWAS
  DIV_HUMAS
  DIV_LITBANG
  DIV_SOSMED
  DIV_DAKWAH
  DIV_INVESTASI
  DIV_HUKUM
  DIV_UMUM
  PUBLIK_ANGGOTA
}

/// 7 divisi operasional (DESIGN.md §5.1). Hanya untuk role DIV_*.
enum Division {
  DIV_HUMAS
  DIV_LITBANG
  DIV_SOSMED
  DIV_DAKWAH
  DIV_INVESTASI
  DIV_HUKUM
  DIV_UMUM
}

/// Aksi yang dicatat ke audit_logs (DESIGN.md §5.3 & §7.2)
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_DENIED
  LOGOUT
  CROSS_DIVISION_DENIED
  ROLE_CHANGED
  DELEGATION_TOGGLED
  USER_INVITED
  USER_ACTIVATED
  LETTER_CREATED
  LETTER_UPDATED
  LETTER_SUBMITTED
  LETTER_APPROVED
  LETTER_PUBLISHED
  LETTER_REJECTED
  LETTER_ARCHIVED
  INCOMING_LETTER_CREATED
  INCOMING_LETTER_DISPOSED
  CASH_FLOW_CREATED
  CASH_FLOW_VERIFIED_BENDAHARA
  CASH_FLOW_VERIFIED_KETUM
  CASH_FLOW_REJECTED
  SUBMISSION_CREATED
  SUBMISSION_UPDATED
  SUBMISSION_SUBMITTED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_PUBLISHED
}

/// Jenis surat resmi (PRD §5.2 & DESIGN §4.2)
enum LetterType {
  SK
  SURAT_TUGAS
  REKOMENDASI
  MAKLUMAT
  UNDANGAN
  PENGANTAR
  EDARAN
}

/// Siklus hidup surat resmi (DESIGN §6.3)
enum LetterStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// Status surat masuk & disposisi
enum IncomingLetterStatus {
  RECEIVED
  DISPOSITION_PENDING
  DISPOSED
  ARCHIVED
}

/// Tipe arus kas (DESIGN §4.3)
enum CashFlowType {
  INFLOW
  OUTFLOW
}

/// Akun kas resmi yayasan (DESIGN §4.3 & PRD §5.3)
enum AccountCategory {
  BSI_GIRO
  BRANKAS_KAS_KECIL
  MANDIRI_WAKAF
}

/// Status dual-approval voucher keuangan (DESIGN §6.4)
enum CashFlowStatus {
  PENDING
  VERIFIED_BENDAHARA
  VERIFIED_KETUM
  REJECTED
}

/// Status usulan program 7 divisi (DESIGN §6.5)
enum SubmissionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

/// Pengguna & delegasi (DESIGN.md §4.1)
model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  full_name String   @db.VarChar(255)
  role      UserRole
  division  Division?
  /// Soft-disable akun (tidak bisa login)
  is_active Boolean  @default(true) @map("is_active")
  /// Flag delegasi: pimpinan bisa mengundang & mengelola anggota tanpa IT
  can_manage_users Boolean @default(false) @map("can_manage_users")
  /// Diturunkan saat login Google pertama (bisa diubah di profil)
  profile_picture_url String? @map("profile_picture_url")
  /// Nomor anggota resmi untuk e-KTA (FR-PUBLIC-02)
  member_number     String?  @unique @map("member_number") @db.VarChar(50)
  /// Tanggal mulai menjadi anggota (dasar masa berlaku e-KTA)
  member_since      DateTime? @map("member_since") @db.Timestamptz
  /// Tanggal terbit e-KTA (nomor kartu cetak/digital)
  card_issued_at    DateTime? @map("card_issued_at") @db.Timestamptz
  /// Masa berlaku e-KTA (5 tahun sejak terbit; FR-PUBLIC-02)
  card_expires_at   DateTime? @map("card_expires_at") @db.Timestamptz
  /// Siapa yang mengundang akun ini (null = di-seed langsung)
  invited_by_id String? @map("invited_by_id")
  invited_at  DateTime? @map("invited_at") @db.Timestamptz
  last_login_at DateTime? @map("last_login_at") @db.Timestamptz
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at DateTime @updatedAt @map("updated_at") @db.Timestamptz

  refresh_sessions RefreshSession[]
  audit_logs       AuditLog[]           @relation("AuditActor")
  created_letters  OfficialLetter[]     @relation("LetterCreator")
  approved_letters OfficialLetter[]     @relation("LetterApprover")
  cash_flows       CashFlow[]           @relation("CashFlowCreator")
  submissions      DivisionSubmission[] @relation("SubmissionCreator")

  @@map("users")
}

/// Refresh token (jti) — DESIGN.md §4.5; blacklist jti di Redis
model RefreshSession {
  id        String   @id @default(uuid())
  jti       String   @unique
  user_id   String   @map("user_id")
  user_agent String? @map("user_agent")
  ip_address String? @map("ip_address")
  revoked   Boolean  @default(false)
  expires_at DateTime @map("expires_at") @db.Timestamptz
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_sessions")
}

/// Jejak audit keamanan (DESIGN.md §4.5 & §5.3)
model AuditLog {
  id         String   @id @default(uuid())
  action     AuditAction
  /// Pelaku aksi (null = aksi sistem/anonim)
  actor_id   String?  @map("actor_id")
  /// Subjek yang dikenai aksi (mis. id user yang diubah perannya)
  target_id  String?  @map("target_id")
  /// Endpoint atau resource terkait (mis. /api/v1/letters)
  resource   String?
  ip_address String?  @map("ip_address")
  user_agent String?  @map("user_agent")
  metadata   Json     @default("[]")
  created_at DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("AuditActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([actor_id])
  @@index([action])
  @@map("audit_logs")
}


/// Persuratan resmi (DESIGN §4.2 & PRD §5.2)
model OfficialLetter {
  id              String       @id @default(uuid())
  letter_number   String       @unique @map("letter_number") @db.VarChar(100)
  title           String       @db.VarChar(255)
  letter_type     LetterType   @map("letter_type")
  content_payload Json         @map("content_payload")
  kop_config      Json         @map("kop_config")
  signatories     Json         @map("signatories")
  sha256_hash     String       @unique @map("sha256_hash") @db.VarChar(64)
  qr_verify_url   String       @map("qr_verify_url")
  status          LetterStatus @default(DRAFT)
  rejection_note  String?      @map("rejection_note")
  pdf_storage_url String?      @map("pdf_storage_url")
  created_by_id   String       @map("created_by_id")
  approved_by_id  String?      @map("approved_by_id")
  published_at    DateTime?    @map("published_at") @db.Timestamptz
  created_at      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updated_at      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  created_by  User  @relation("LetterCreator", fields: [created_by_id], references: [id])
  approved_by User? @relation("LetterApprover", fields: [approved_by_id], references: [id])

  @@index([letter_type])
  @@index([status])
  @@index([created_by_id])
  @@map("official_letters")
}

/// Counter penomoran surat otomatis per tahun & jenis (DESIGN §6.1)
model LetterSequence {
  id             String     @id @default(uuid())
  year           Int
  letter_type    LetterType @map("letter_type")
  current_number Int        @default(0) @map("current_number")

  @@unique([year, letter_type])
  @@map("letter_sequences")
}

/// Agenda surat masuk & disposisi wilayah (PRD §5.2)
model IncomingLetter {
  id                          String               @id @default(uuid())
  agenda_number               String               @unique @map("agenda_number") @db.VarChar(50)
  source_institution          String               @map("source_institution") @db.VarChar(255)
  letter_number               String               @map("letter_number") @db.VarChar(100)
  subject                     String               @db.VarChar(255)
  received_date               DateTime             @map("received_date") @db.Date
  file_url                    String?              @map("file_url")
  disposition_note            String?              @map("disposition_note")
  disposition_target_division Division?            @map("disposition_target_division")
  status                      IncomingLetterStatus @default(RECEIVED)
  received_by_id              String               @map("received_by_id")
  disposed_by_id              String?              @map("disposed_by_id")
  disposed_at                 DateTime?            @map("disposed_at") @db.Timestamptz
  created_at                  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updated_at                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([received_date])
  @@map("incoming_letters")
}


/// Arus kas & voucher pengeluaran/penerimaan (DESIGN §4.3 & PRD §5.3)
model CashFlow {
  id                       String          @id @default(uuid())
  voucher_number           String          @unique @map("voucher_number") @db.VarChar(50)
  transaction_date         DateTime        @map("transaction_date") @db.Date
  type                     CashFlowType
  account_category         AccountCategory @map("account_category")
  amount                   Decimal         @db.Decimal(15, 2)
  description              String
  receipt_attachment_url   String?         @map("receipt_attachment_url")
  status                   CashFlowStatus  @default(PENDING)
  rejection_note           String?         @map("rejection_note")
  verified_by_bendahara_id String?         @map("verified_by_bendahara_id")
  verified_by_bendahara_at DateTime?       @map("verified_by_bendahara_at") @db.Timestamptz
  verified_by_ketum_id     String?         @map("verified_by_ketum_id")
  verified_by_ketum_at     DateTime?       @map("verified_by_ketum_at") @db.Timestamptz
  created_by_id            String          @map("created_by_id")
  created_at               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updated_at               DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  created_by User @relation("CashFlowCreator", fields: [created_by_id], references: [id])

  @@index([transaction_date])
  @@index([account_category])
  @@index([status])
  @@map("cash_flow")
}

/// Counter penomoran voucher kas per tahun (DESIGN §6.1)
model VoucherSequence {
  id             String @id @default(uuid())
  year           Int    @unique
  current_number Int    @default(0) @map("current_number")

  @@map("voucher_sequences")
}

/// Usulan program 7 divisi (DESIGN §4.4 & PRD §5.4)
model DivisionSubmission {
  id               String           @id @default(uuid())
  tracking_id      String           @unique @map("tracking_id") @db.VarChar(50)
  division         Division
  program_title    String           @map("program_title") @db.VarChar(255)
  budget_estimate  Decimal          @map("budget_estimate") @db.Decimal(15, 2)
  target_audience  String?          @map("target_audience")
  execution_date   DateTime?        @map("execution_date") @db.Date
  submission_data  Json             @default("{}") @map("submission_data")
  attachments      Json             @default("[]")
  status           SubmissionStatus @default(DRAFT)
  approval_notes   String?          @map("approval_notes")
  reviewed_by_id   String?          @map("reviewed_by_id")
  reviewed_at      DateTime?        @map("reviewed_at") @db.Timestamptz
  submitted_by_id  String           @map("submitted_by_id")
  created_at       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updated_at       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  submitted_by User @relation("SubmissionCreator", fields: [submitted_by_id], references: [id])

  @@index([division])
  @@index([status])
  @@map("division_submissions")
}

/// Counter tracking ID usulan divisi per tahun (DESIGN §6.2)
model SubmissionSequence {
  id             String @id @default(uuid())
  year           Int    @unique
  current_number Int    @default(0) @map("current_number")

  @@map("submission_sequences")
}

/// Berkas terunggah (DESIGN §4.5 & §8.4)
model UploadedFile {
  id            String    @id @default(uuid())
  original_name String    @map("original_name") @db.VarChar(255)
  mime_type     String    @map("mime_type") @db.VarChar(100)
  file_size     Int       @map("file_size")
  storage_path  String    @map("storage_path")
  public_url    String    @map("public_url")
  uploader_id   String    @map("uploader_id")
  division      Division?
  created_at    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([uploader_id])
  @@index([division])
  @@map("uploaded_files")
}
